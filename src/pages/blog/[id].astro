---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/react/Header";
import Footer from "../../components/react/Footer";
import ReadNextPostPreview from "../../components/react/ReadNextPostPreview";
import ShareLinks from "../../components/react/ShareLinks";
import SectionHeading from "../../components/react/SectionHeading";
import FormattedDate from "../../components/react/FormattedDate";
import siteConfig from "../../data/site-config";
import { readingTime } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
  const postCount = posts.length;
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: index + 1 !== postCount ? posts[index + 1] : null,
      nextPost: index !== 0 ? posts[index - 1] : null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
  prevPost: CollectionEntry<"blog"> | null;
  nextPost: CollectionEntry<"blog"> | null;
};

const { post, prevPost, nextPost } = Astro.props as Props;
const { title, publishDate, updatedDate, featureImage, pdf, download } = post.data;
const { Content } = await render(post);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout title={title} description={post.data.excerpt}>
  <Header
    slot="header"
    client:load
    title={siteConfig.title}
    navLinks={siteConfig.primaryNavLinks}
    currentPath={Astro.url.pathname}
    className="bg-slate-50 border-b border-slate-100"
  />
  <main class="grow px-4 py-12 sm:px-8 sm:py-16">
    <article class="mx-auto mb-12 max-w-6xl sm:mb-16">
      <header class="mx-auto mb-6 max-w-3xl sm:mb-8">
        <div class="mb-3 text-sm uppercase tracking-wider text-slate-500">
          <FormattedDate date={publishDate} />
          {updatedDate && (
            <span>
              {" "}(Updated on <FormattedDate date={updatedDate} />)
            </span>
          )}
          {post.body && (
            <span> &bull; {readingTime(post.body)}</span>
          )}
        </div>
        <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl md:text-5xl">{title}</h1>
      </header>
      {featureImage?.src && (
        <figure class="my-6 sm:my-8 lg:my-12">
          <img
            src={featureImage.src}
            alt={featureImage.alt || ""}
            class="w-full rounded-lg"
          />
          {featureImage.caption && (
            <figcaption class="mt-1.5 text-xs sm:text-sm">{featureImage.caption}</figcaption>
          )}
        </figure>
      )}
      <div class="mx-auto max-w-3xl">
        {pdf && (
          <a
            href={pdf}
            download
            class="mb-8 inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-shadow hover:shadow-button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download PDF
          </a>
        )}
        {download && (
          <a
            href={download.src}
            download
            class="mb-8 inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-shadow hover:shadow-button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {download.label}
          </a>
        )}
        <div class="prose prose-slate max-w-none sm:prose-lg">
          <Content />
        </div>
        <ShareLinks title={title} url={pageUrl} />
      </div>
    </article>
    {(prevPost || nextPost) && (
      <div class="mx-auto mb-12 max-w-3xl sm:mb-16">
        <SectionHeading className="mb-8 sm:mb-12">Read Next</SectionHeading>
        {nextPost && (
          <ReadNextPostPreview
            id={nextPost.id}
            title={nextPost.data.title}
            publishDate={nextPost.data.publishDate}
            updatedDate={nextPost.data.updatedDate}
            featureImage={nextPost.data.featureImage}
          />
        )}
        {prevPost && (
          <ReadNextPostPreview
            id={prevPost.id}
            title={prevPost.data.title}
            publishDate={prevPost.data.publishDate}
            updatedDate={prevPost.data.updatedDate}
            featureImage={prevPost.data.featureImage}
          />
        )}
      </div>
    )}
  </main>
  <Footer
    slot="footer"
    title={siteConfig.title}
    secondaryNavLinks={siteConfig.secondaryNavLinks}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
