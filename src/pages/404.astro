---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/react/Header";
import Footer from "../components/react/Footer";
import siteConfig from "../data/site-config";
---

<BaseLayout title="Not Found">
  <Header
    slot="header"
    client:load
    title={siteConfig.title}
    navLinks={siteConfig.primaryNavLinks}
    className="bg-slate-50 border-b border-slate-100"
  />
  <main class="flex grow items-center justify-center px-4 py-12 sm:px-8 sm:py-16">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-slate-900">404</h1>
      <p class="mt-4 text-lg text-slate-700">Page not found</p>
      <a
        class="mt-8 inline-flex items-center justify-center rounded-full bg-primary px-8 py-2.5 font-semibold text-white transition duration-300 hover:shadow-button"
        href="/"
      >
        Go Home
      </a>
    </div>
  </main>
  <Footer
    slot="footer"
    title={siteConfig.title}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
