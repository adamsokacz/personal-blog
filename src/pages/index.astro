---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/react/Header";
import Hero from "../components/react/Hero";
import Footer from "../components/react/Footer";
import FeaturedPostPreview from "../components/react/FeaturedPostPreview";
import PostPreview from "../components/react/PostPreview";
import SectionHeading from "../components/react/SectionHeading";
import siteConfig from "../data/site-config";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());

const featuredPosts = posts.filter((post) => post.data.featured);
const latestPosts = posts.filter((post) => !post.data.featured).slice(0, 3);
---

<BaseLayout description={siteConfig.description}>
  <div class="relative border-b border-slate-100 bg-slate-50" slot="header">
    <Header
      client:load
      title={siteConfig.title}
      navLinks={siteConfig.primaryNavLinks}
      currentPath={Astro.url.pathname}
    />
    <Hero {...siteConfig.hero} socialLinks={siteConfig.socialLinks} />
  </div>
  <main class="grow py-12 sm:py-16">
    {featuredPosts.length > 0 && (
      <div class="mb-12 border-b border-slate-200 px-4 sm:mb-16 sm:px-8">
        <div class="mx-auto max-w-6xl">
          {featuredPosts.map((post) => (
            <FeaturedPostPreview
              id={post.id}
              title={post.data.title}
              publishDate={post.data.publishDate}
              updatedDate={post.data.updatedDate}
              excerpt={post.data.excerpt}
              featureImage={post.data.featureImage}
            />
          ))}
        </div>
      </div>
    )}
    <div class="mb-12 px-4 sm:mb-16 sm:px-8">
      {latestPosts.length > 0 && (
        <>
          <div class="mx-auto mb-8 max-w-3xl sm:mb-12">
            <SectionHeading>Latest Articles</SectionHeading>
          </div>
          <div class="mx-auto max-w-3xl xl:max-w-6xl">
            {latestPosts.map((post) => (
              <PostPreview
                id={post.id}
                title={post.data.title}
                publishDate={post.data.publishDate}
                updatedDate={post.data.updatedDate}
                excerpt={post.data.excerpt}
                featured={post.data.featured}
                featureImage={post.data.featureImage}
              />
            ))}
          </div>
          <div class="mx-auto max-w-3xl border-t border-slate-200 pt-8 sm:pt-12">
            <a
              class="inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-8 py-2.5 font-semibold text-white transition duration-300 hover:shadow-button"
              href="/blog"
            >
              View All Posts
            </a>
          </div>
        </>
      )}
    </div>
  </main>
  <Footer
    slot="footer"
    title={siteConfig.title}
    secondaryNavLinks={siteConfig.secondaryNavLinks}
    socialLinks={siteConfig.socialLinks}
  />
</BaseLayout>
